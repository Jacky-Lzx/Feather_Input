{
  "name": "真实 Rime 候选翻页",
  "steps": [
    { "action": "activate" },
    {
      "action": "text",
      "value": "ni",
      "expect": { "handled": true, "candidate_count_min": 2 }
    },
    {
      "action": "key",
      "key": "page_down",
      "expect": { "handled": true, "no_commit": true, "candidate_count_min": 1 }
    },
    {
      "action": "key",
      "key": "page_up",
      "expect": { "handled": true, "no_commit": true, "candidate_count_min": 2 }
    }
  ]
}
