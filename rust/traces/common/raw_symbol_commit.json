{
  "name": "组合期间输入 ASCII 符号时提交原始输入而不选择候选",
  "steps": [
    { "action": "activate" },
    { "action": "text", "value": "githu", "expect": { "handled": true } },
    {
      "action": "text",
      "value": ".",
      "expect": { "handled": true, "commit": "githu.", "preedit": "" }
    },
    { "action": "text", "value": "shijie", "expect": { "handled": true } },
    {
      "action": "text",
      "value": "@",
      "expect": { "handled": true, "commit": "shijie@", "preedit": "" }
    }
  ]
}
