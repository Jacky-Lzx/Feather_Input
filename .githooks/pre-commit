#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

scope="rust platforms/macos scripts/build-macos-dev-harness.sh scripts/build-macos-input-method.sh scripts/test-macos-dev-harness.sh scripts/test-macos-input-method.sh scripts/test-rime-traces.sh scripts/format-macos.sh scripts/check-macos.sh"

if ! git diff --quiet -- $scope; then
    echo "提交前检查失败：本次代码范围中存在未暂存修改。" >&2
    echo "请先暂存、还原或移动这些修改，避免格式化扩大提交范围。" >&2
    exit 1
fi

untracked=$(git ls-files --others --exclude-standard -- $scope)
if [ -n "$untracked" ]; then
    echo "提交前检查失败：本次代码范围中存在未跟踪文件：" >&2
    echo "$untracked" >&2
    echo "请先决定是否将它们加入本次提交。" >&2
    exit 1
fi

echo "正在格式化 Rust 代码……"
cargo fmt --manifest-path rust/Cargo.toml --all

if [ "$(uname -s)" = "Darwin" ]; then
    echo "正在格式化 Swift 代码……"
    scripts/format-macos.sh
fi

if ! git diff --quiet -- $scope; then
    echo "代码格式化工具已修改文件，本次提交已中止。" >&2
    echo "请审核格式化结果，重新 git add 后再次提交。" >&2
    exit 1
fi

scripts/check-rust.sh
if [ "$(uname -s)" = "Darwin" ]; then
    exec scripts/check-macos.sh
fi

echo "非 macOS 环境：跳过 macOS Swift 检查。"
